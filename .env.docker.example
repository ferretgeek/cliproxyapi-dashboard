# CPA-X（Docker/容器部署）示例配置
#
# 用法：
# 1) 复制为 .env.docker
# 2) 生成至少 32 字符的随机访问密钥并填入下方空值
# 3) 运行 docker compose --env-file .env.docker up -d --build
#
# 重要：
# - 容器内必须监听 0.0.0.0 才能让端口映射生效
# - 容器模式通常无法使用 systemd，因此“自动更新/服务控制”默认不可用（建议关闭）

# 面板
CLIPROXY_PANEL_PANEL_PORT=8080
CLIPROXY_PANEL_BIND_HOST=0.0.0.0
# 宿主机默认只发布到回环地址；远程访问应经 HTTPS 反向代理。
CLIPROXY_PANEL_PUBLISH_HOST=127.0.0.1
CLIPROXY_PANEL_PUBLISHED_PORT=8080
# 必填，且至少 32 字符；留空时 Compose 会拒绝启动。
CLIPROXY_PANEL_PANEL_ACCESS_KEY=

# CLIProxyAPI 管理接口（通常在宿主机上）
CLIPROXY_PANEL_DEPLOYMENT_MODE=docker
CLIPROXY_PANEL_CLIPROXY_API_BASE=http://host.docker.internal
CLIPROXY_PANEL_CLIPROXY_API_PORT=8317

# 上游密钥（如启用才需要）
CLIPROXY_PANEL_MANAGEMENT_KEY=
CLIPROXY_PANEL_MODELS_API_KEY=
# Docker settings are persisted under ./data; these environment values override them when non-empty.
CLIPROXY_PANEL_SETTINGS_PATH=/app/data/panel_settings.json
CLIPROXY_PANEL_LOG_SCAN_BUDGET_MB=4

# 容器内路径（需要你把宿主机文件挂载到这些位置）
CLIPROXY_PANEL_CLIPROXY_CONFIG=/mnt/cliproxy/config.yaml
CLIPROXY_PANEL_CLIPROXY_LOG=/mnt/cliproxy/main.log
CLIPROXY_PANEL_AUTH_DIR=/mnt/cliproxy/auths

# 容器模式建议关闭自动更新
CLIPROXY_PANEL_AUTO_UPDATE_ENABLED=false

# 日志可能来自不同时区的宿主机，auto 会根据日志时间和文件 mtime 自动推断
CLIPROXY_PANEL_LOG_TIMEZONE=auto
CLIPROXY_PANEL_LOG_INITIAL_SCAN_MAX_MB=64
CLIPROXY_PANEL_LOG_CLEAR_ENABLED=false

# 价格自动同步（默认开启；当手动价格为 0 时会尝试从权威来源补齐）
# 留空使用默认值或 UI 已保存的设置；填写 true/false 会在重启后覆盖 UI 设置。
CLIPROXY_PANEL_PRICING_AUTO_ENABLED=
CLIPROXY_PANEL_PRICING_AUTO_SOURCE=openrouter
CLIPROXY_PANEL_PRICING_AUTO_MODEL=

# 版本显示优先使用管理接口响应头或配置响应中的 version 字段；无法确认时显示 unknown，不伪造版本。
# /app/X.txt 始终加载；自定义路径会作为附加语录源
CLIPROXY_PANEL_QUOTES_PATH=/app/X.txt

# 留空表示仅同源；如需跨域，填写逗号分隔的明确来源
CLIPROXY_PANEL_CORS_ORIGINS=
